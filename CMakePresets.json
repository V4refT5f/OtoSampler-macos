{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "vs2026-install",
      "displayName": "Visual Studio 2026 (x64) + copy VST3 after build (run VS/CMake as admin)",
      "inherits": "vs2026",
      "cacheVariables": { "OTO_COPY_AFTER_BUILD": "ON" }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64) fallback",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "debug",   "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "release-install", "configurePreset": "vs2026-install", "configuration": "Release" },
    { "name": "release-vs2022", "configurePreset": "vs2022", "configuration": "Release" }
  ]
}
